{
  "name": "hatchhaven-field-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "npm run build",
    "dev": "node scripts/preview.mjs",
    "pretest": "npm run build",
